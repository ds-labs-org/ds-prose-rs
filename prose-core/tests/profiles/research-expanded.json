    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "Actions, constraints and purposes for sharing research datasets. Synthetic example for ds-prose-rs tests; not a published profile."
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "0.1.0"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#editorialNote": [
      {
        "@value": "Test notes. (1) ex:archive is deliberately typed only skos:Concept: a reader must NOT treat it as an ODRL term. (2) ex:distill is deliberately NOT declared here; research-policy.json uses it to test the 'not declared by the loaded profile' warning. (3) prose:* triples are the ds-prose suggestion extension, not ODRL; a reader without the extension must ignore them. (4) The ex:dataSubjectCount note carries HTML on purpose; it must render as plain text."
      }
    ]
  },
