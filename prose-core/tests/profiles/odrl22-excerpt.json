[
  {
    "@id": "http://www.w3.org/ns/odrl/2/distribute",
    "@type": [
      "http://www.w3.org/ns/odrl/2/Action",
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Distribute"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "To supply the Asset to third-parties."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "It is recommended to use nextPolicy to express the allowable usages by third-parties."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Non-Normative"
      }
    ],
    "http://www.w3.org/ns/odrl/2/includedIn": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/use"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/odrl/2/",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/contributor": [
      {
        "@value": "W3C Permissions & Obligations Expression Working Group"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@value": "Stuart Myles"
      },
      {
        "@value": "Víctor Rodríguez-Doncel"
      },
      {
        "@value": "Renato Iannella"
      },
      {
        "@value": "Michael Steidl"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "The ODRL Vocabulary and Expression defines a set of concepts and terms (the vocabulary) and encoding mechanism (the expression) for permissions and obligations statements describing digital content usage based on the ODRL Information Model."
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://www.w3.org/Consortium/Legal/2002/ipr-notice-20021231#Copyright/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "This is the RDF ontology for ODRL Version 2.2 (working draft)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "ODRL Version 2.2"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "2.2"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/odrl/2/commercialize",
    "@type": [
      "http://www.w3.org/ns/odrl/2/Action",
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Commercialize"
      }
    ],
    "http://www.w3.org/2002/07/owl#deprecated": [
      {
        "@value": true
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The act of using the asset in a business environment."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://creativecommons.org/ns#CommercialUse"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/odrl/2/elapsedTime",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "http://www.w3.org/ns/odrl/2/LeftOperand",
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Elapsed Time"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A continuous elapsed time period which may be used for exercising of the action of the Rule. Right operand value MUST be an xsd:duration as defined by [[xmlschema11-2]]."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Only the eq, lt, lteq operators SHOULD be used. See also Metered Time. <br />Example: <code>elpasedTime eq P60M</code> indicates a total elapsed time of 60 Minutes."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Non-Normative"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/odrl/2/purpose",
    "@type": [
      "http://www.w3.org/ns/odrl/2/LeftOperand",
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Purpose"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A defined purpose for exercising the action of the Rule."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Example: Educational use."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Non-Normative"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/odrl/2/spatialCoordinates",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "http://www.w3.org/ns/odrl/2/LeftOperand"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Geospatial Coordinates"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/spatial"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A set of coordinates setting the borders of a geospatial area used for exercising the action of the Rule. The coordinates MUST include longitude and latitude, they MAY include altitude and the geodetic datum."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "The default values are the altitude of earth's surface at this location and the WGS 84 datum."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Non-Normative"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/odrl/2/systemDevice",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "http://www.w3.org/ns/odrl/2/LeftOperand",
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "System Device"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "An identified computing system or computing device used for exercising the action of the Rule."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/system"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/device"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Example: The system device can be identified by a unique code created from the used hardware."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Non-Normative"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/odrl/2/Policy",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/2000/01/rdf-schema#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Policy"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A non-empty group of Permissions and/or Prohibitions."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A Policy may contain multiple Rules."
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/odrl/2/spatial",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "http://www.w3.org/ns/odrl/2/LeftOperand"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Geospatial Named Area"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A named and identified geospatial area with defined borders which is used for exercising the action of the Rule. An IRI MUST be used to represent this value."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A code value for the area and source of the code must be presented in the Right Operand. <br />Example: the [[iso3166]] Country Codes or the Getty Thesaurus of Geographic Names. "
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Non-Normative"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/odrl/2/perm",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "http://www.w3.org/ns/odrl/2/ConflictTerm",
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Prefer Permissions"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Permissions take preference over prohibitions."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Used to determine policy conflict outcomes."
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/odrl/2/use",
    "@type": [
      "http://www.w3.org/ns/odrl/2/Action",
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Use"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "To use the Asset"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Use is the most generic action for all non-third-party usage. More specific types of the use action can be expressed by more targetted actions."
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/odrl/2/Agreement",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/2000/01/rdf-schema#Class",
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Agreement"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Policy"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Assertion"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/Request"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/Privacy"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/Ticket"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/Offer"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A Policy that grants the assignee a Rule over an Asset from an assigner."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "An Agreement Policy MUST contain at least one Permission or Prohibition rule, a Party with Assigner function, and a Party with Assignee function (in the same Permission or Prohibition). The Agreement Policy will grant the terms of the Policy from the Assigner to the Assignee."
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/odrl/2/gteq",
    "@type": [
      "http://www.w3.org/ns/odrl/2/Operator",
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Greater than or equal to"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Indicating that a given value is greater than or equal to the right operand of the Constraint."
      }
    ]
  }
]
