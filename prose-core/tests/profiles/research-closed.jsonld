{
  "@context": {
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "dct": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "prose": "https://ds-labs-org.github.io/ds-prose-rs/profile#",
    "ex": "https://example.org/odrl/profile/research/"
  },
  "@graph": [
    {
      "@id": "https://example.org/odrl/profile/research",
      "@type": "owl:Ontology",
      "rdfs:label": [
        { "@value": "Research Data Profile", "@language": "en" },
        { "@value": "Forschungsdatenprofil", "@language": "de" }
      ],
      "dct:description": { "@value": "Actions, constraints and purposes for sharing research datasets. Synthetic example for ds-prose-rs tests; not a published profile.", "@language": "en" },
      "owl:versionInfo": "0.1.0",
      "skos:editorialNote": "Test notes. (1) ex:archive is deliberately typed only skos:Concept: a reader must NOT treat it as an ODRL term. (2) ex:distill is deliberately NOT declared here; research-policy.json uses it to test the 'not declared by the loaded profile' warning. (3) prose:* triples are the ds-prose suggestion extension, not ODRL; a reader without the extension must ignore them. (4) The ex:dataSubjectCount note carries HTML on purpose; it must render as plain text."
    },

    {
      "@id": "ex:train",
      "@type": ["odrl:Action", "skos:Concept"],
      "rdfs:isDefinedBy": { "@id": "https://example.org/odrl/profile/research" },
      "rdfs:label": [
        { "@value": "Train", "@language": "en" },
        { "@value": "Trainieren", "@language": "de" }
      ],
      "skos:definition": { "@value": "To use the Asset as training data for a machine-learning model.", "@language": "en" },
      "odrl:includedIn": { "@id": "odrl:use" }
    },
    {
      "@id": "ex:fineTune",
      "@type": ["odrl:Action", "skos:Concept"],
      "rdfs:isDefinedBy": { "@id": "https://example.org/odrl/profile/research" },
      "rdfs:label": { "@value": "Fine-tune", "@language": "en" },
      "skos:definition": { "@value": "To adapt an already trained model using the Asset.", "@language": "en" },
      "skos:note": { "@value": "Fine-tuning implies that the Asset may be read.", "@language": "en" },
      "odrl:includedIn": { "@id": "ex:train" },
      "odrl:implies": { "@id": "odrl:read" }
    },
    {
      "@id": "ex:pseudonymise",
      "@type": ["odrl:Action", "skos:Concept"],
      "rdfs:isDefinedBy": { "@id": "https://example.org/odrl/profile/research" },
      "rdfs:label": { "@value": "Pseudonymise", "@language": "en" },
      "skos:definition": { "@value": "To replace direct identifiers in the Asset with pseudonyms before any other use.", "@language": "en" },
      "odrl:includedIn": { "@id": "odrl:modify" }
    },

    {
      "@id": "ex:dataSubjectCount",
      "@type": ["odrl:LeftOperand", "owl:NamedIndividual", "skos:Concept"],
      "rdfs:isDefinedBy": { "@id": "https://example.org/odrl/profile/research" },
      "rdfs:label": { "@value": "Number of data subjects", "@language": "en" },
      "skos:definition": { "@value": "The number of distinct data subjects represented in a result derived from the Asset. Right operand value MUST be an xsd:integer.", "@language": "en" },
      "skos:note": { "@value": "Only the <code>gteq</code> and <code>gt</code> operators SHOULD be used.<br />Small counts risk re-identification.", "@language": "en" },
      "prose:operator": [ { "@id": "odrl:gteq" }, { "@id": "odrl:gt" } ],
      "prose:datatype": { "@id": "xsd:integer" },
      "prose:closed": true
    },
    {
      "@id": "ex:researchPurpose",
      "@type": ["odrl:LeftOperand", "owl:NamedIndividual", "skos:Concept"],
      "rdfs:isDefinedBy": { "@id": "https://example.org/odrl/profile/research" },
      "skos:prefLabel": { "@value": "Research purpose", "@language": "en" },
      "rdfs:comment": "The research purpose the action of the Rule is exercised for.",
      "skos:broader": { "@id": "odrl:purpose" },
      "prose:operator": [ { "@id": "odrl:eq" }, { "@id": "odrl:isAnyOf" }, { "@id": "odrl:isNoneOf" } ],
      "prose:rightOperand": [ { "@id": "ex:academic" }, { "@id": "ex:commercialResearch" } ],
      "prose:closed": true
    },
    {
      "@id": "ex:retentionPeriod",
      "@type": ["odrl:LeftOperand", "owl:NamedIndividual", "skos:Concept"],
      "rdfs:isDefinedBy": { "@id": "https://example.org/odrl/profile/research" },
      "rdfs:label": { "@value": "Retention period", "@language": "en" },
      "skos:definition": { "@value": "How long results derived from the Asset may be kept, counted from their creation.", "@language": "en" },
      "prose:operator": [ { "@id": "odrl:lteq" }, { "@id": "odrl:lt" } ],
      "prose:datatype": { "@id": "xsd:duration" }
    },

    {
      "@id": "ex:withinRegion",
      "@type": ["odrl:Operator", "owl:NamedIndividual", "skos:Concept"],
      "rdfs:isDefinedBy": { "@id": "https://example.org/odrl/profile/research" },
      "rdfs:label": { "@value": "Within region", "@language": "en" },
      "skos:definition": { "@value": "Indicating that a given location lies inside the region named by the right operand of the Constraint.", "@language": "en" }
    },

    {
      "@id": "ex:academic",
      "@type": ["odrl:RightOperand", "owl:NamedIndividual", "skos:Concept"],
      "rdfs:isDefinedBy": { "@id": "https://example.org/odrl/profile/research" },
      "rdfs:label": { "@value": "Academic research", "@language": "en" },
      "skos:definition": { "@value": "Research carried out by an accredited academic institution with no commercial sponsor.", "@language": "en" }
    },
    {
      "@id": "ex:clinical",
      "@type": ["odrl:RightOperand", "owl:NamedIndividual", "skos:Concept"],
      "rdfs:isDefinedBy": { "@id": "https://example.org/odrl/profile/research" },
      "rdfs:label": { "@value": "Clinical research", "@language": "en" },
      "skos:definition": { "@value": "Academic research that involves human participants under an approved study protocol.", "@language": "en" },
      "skos:broader": { "@id": "ex:academic" }
    },
    {
      "@id": "ex:commercialResearch",
      "@type": ["odrl:RightOperand", "owl:NamedIndividual", "skos:Concept"],
      "rdfs:isDefinedBy": { "@id": "https://example.org/odrl/profile/research" },
      "rdfs:label": { "@value": "Commercial research", "@language": "en" },
      "skos:definition": { "@value": "Research funded or directed by a commercial organisation.", "@language": "en" }
    },

    {
      "@id": "ex:dataSteward",
      "@type": ["rdf:Property", "owl:ObjectProperty", "skos:Concept"],
      "rdfs:isDefinedBy": { "@id": "https://example.org/odrl/profile/research" },
      "rdfs:subPropertyOf": { "@id": "odrl:function" },
      "rdfs:label": { "@value": "Data steward", "@language": "en" },
      "skos:definition": { "@value": "The Party accountable for the curation of the Asset.", "@language": "en" }
    },
    {
      "@id": "ex:ResearchAgreement",
      "@type": ["rdfs:Class", "owl:Class", "skos:Concept"],
      "rdfs:isDefinedBy": { "@id": "https://example.org/odrl/profile/research" },
      "rdfs:subClassOf": { "@id": "odrl:Agreement" },
      "rdfs:label": { "@value": "Research agreement", "@language": "en" },
      "skos:definition": { "@value": "An Agreement between a data holder and a research institution.", "@language": "en" }
    },
    {
      "@id": "ex:Dataset",
      "@type": ["rdfs:Class", "owl:Class", "skos:Concept"],
      "rdfs:isDefinedBy": { "@id": "https://example.org/odrl/profile/research" },
      "rdfs:subClassOf": { "@id": "odrl:Asset" },
      "rdfs:label": { "@value": "Dataset", "@language": "en" }
    },
    {
      "@id": "ex:ignore",
      "@type": ["odrl:ConflictTerm", "owl:NamedIndividual", "skos:Concept"],
      "rdfs:isDefinedBy": { "@id": "https://example.org/odrl/profile/research" },
      "rdfs:label": { "@value": "Ignore conflicts", "@language": "en" },
      "skos:definition": { "@value": "Conflicting rules are ignored; the remaining rules apply.", "@language": "en" }
    },

    {
      "@id": "ex:archive",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": { "@id": "https://example.org/odrl/profile/research" },
      "rdfs:label": { "@value": "Archive", "@language": "en" },
      "skos:definition": { "@value": "Deliberately not typed odrl:Action: a skos:Concept alone is not an ODRL term and must not appear in any dropdown.", "@language": "en" }
    },

    {
      "@id": "ex:actions",
      "@type": "skos:Collection",
      "skos:prefLabel": { "@value": "Actions for Rules", "@language": "en" },
      "skos:member": [ { "@id": "ex:train" }, { "@id": "ex:fineTune" }, { "@id": "ex:pseudonymise" } ]
    }
  ]
}
