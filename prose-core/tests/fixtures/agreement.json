{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "uid": "http://example.com/policy:2020",
  "conflict": "prohibit",
  "assigner": "http://example.com/party:alice",
  "assignee": "http://example.com/party:bob",
  "permission": [{
    "target": "http://example.com/data:set1",
    "action": { "rdf:value": { "@id": "odrl:distribute" },
                "refinement": [{ "leftOperand": "count", "operator": "lteq", "rightOperand": 5 }] },
    "constraint": [{
      "or": [
        { "leftOperand": "purpose", "operator": "isAnyOf", "rightOperand": ["research", "education"] },
        { "leftOperand": "spatial", "operator": "eq", "rightOperand": { "@id": "https://example.com/geo/EU" } }
      ]
    }]
  }]
}
